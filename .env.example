# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). No subas .env.local al repositorio.

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" o "publishable" (es segura en el navegador; el RLS protege los datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dirección pública de la web, sin barra final. Se usa en los enlaces /r/... y en los correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre provisional de la comunidad (opcional; si falta se usa el de src/config/site.ts)
# NEXT_PUBLIC_APP_NAME=You In

# SOLO para el script de comprobación `npm run verify:story` contra un proyecto de pruebas.
# La app no la usa. Nunca la expongas en el navegador ni en producción.
# SUPABASE_SERVICE_ROLE_KEY=
