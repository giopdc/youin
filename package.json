{
  "name": "you-in",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run_local.sh",
    "verify:story": "node --experimental-strip-types scripts/verify-story.mts",
    "deploy": "opennextjs-cloudflare build && node scripts/cf-patch-cookie.mjs && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:direct": "opennextjs-cloudflare build && node scripts/cf-patch-cookie.mjs && node scripts/cf-embed-assets.mjs && wrangler deploy -c wrangler.direct.jsonc"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
